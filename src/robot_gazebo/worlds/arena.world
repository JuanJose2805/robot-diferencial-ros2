<?xml version="1.0"?>

<sdf version="1.6">

  <!-- Arena de pruebas Robotics 4.0: 10 x 10 m con obstaculos.
       El robot aparece en (0, 0); esa zona se mantiene libre. -->
  <world name="robotics40_arena">

    <gravity>0 0 -9.81</gravity>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>world</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="pared_norte">
      <static>true</static>
      <pose>0 5.1 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.4 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pared_sur">
      <static>true</static>
      <pose>0 -5.1 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.4 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pared_este">
      <static>true</static>
      <pose>5.1 0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.4 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pared_oeste">
      <static>true</static>
      <pose>-5.1 0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.4 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="caja_1">
      <static>true</static>
      <pose>2.5 1.5 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="caja_2">
      <static>true</static>
      <pose>-2.0 2.5 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 2.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 2.0 1.0</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="caja_3">
      <static>true</static>
      <pose>3.0 -1.0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.5 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.5 1.0</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cilindro_1">
      <static>true</static>
      <pose>1.5 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cilindro_2">
      <static>true</static>
      <pose>-3.0 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cilindro_3">
      <static>true</static>
      <pose>0.0 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pared_interior">
      <static>true</static>
      <pose>-1.0 -3.5 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.5 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 0.2 1.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>

</sdf>
